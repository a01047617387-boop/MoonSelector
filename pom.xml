name: Build ItemSelector

on:
  push:
    branches: [ main, master ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: 코드 가져오기
        uses: actions/checkout@v4

      - name: Java 21 설치
        uses: actions/setup-java@v4
        with:
          java-version: '21'
          distribution: 'temurin'

      - name: Maven 빌드
        run: mvn clean package -B

      - name: JAR 파일 업로드
        uses: actions/upload-artifact@v4
        with:
          name: MoonSelector
          path: target/MoonSelector-*.jar
          retention-days: 30